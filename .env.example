# WAW Hybrid environment template
# Never put real values in this file, APK, frontend bundle, or git history.

WAW_ENV=development
WAW_API_BASE_URL=http://localhost:8787
WAW_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Server-side only; do not expose to browser, APK, or Cloudflare Pages.
META_GRAPH_API_VERSION=vXX.X
META_WHATSAPP_BUSINESS_PHONE_ID=
META_WHATSAPP_BUSINESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Server-side infrastructure
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
STUN_URLS=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
